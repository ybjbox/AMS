# ===== AMS 环境变量示例 =====
# 复制为 .env.local 使用（server/env.ts 按 真实进程环境 > .env.local > .env 的优先级加载）。
# 前端仅注入 VITE_ 前缀变量；其余为 Node 服务端变量。

# ---- 服务监听 ----
# 安全默认只绑 127.0.0.1；Docker/局域网部署显式设 0.0.0.0（启动日志会打印安全告警）
# HOST=127.0.0.1
# PORT=3000
# NODE_ENV=production
# 进程时区。业务按本地日历日判定（考勤归属日、合同剩余天数、提醒扫描的"今天"），
# Linux 容器默认 UTC 会让这些口径整体偏移；本机部署可留空（跟随系统）。
# TZ=Asia/Shanghai
# 只有确实放在 Nginx/Traefik 这类反向代理后面时才设（值 = 可信跳数，例如 1）。
# 不设时服务端一律不读 X-Forwarded-For，审计与登录限流拿的是真实连接地址；
# 在没有可信代理的公网入口上设它，等于允许客户端伪造自己的来源 IP。
# TRUST_PROXY=

# ---- 数据与凭据 ----
# SQLite 数据目录（含 ams.db / 备份 / 上传文件 / 导出脚本模板）；Docker 挂卷场景指向挂载点
# DATA_DIR=
# 首次启动种子 admin 口令（至少 10 位含字母数字）；不设置则控制台打印随机密码并写入 data/ADMIN_CREDENTIALS.txt
# AMS_ADMIN_PASSWORD=

# ---- 定时任务 ----
# 自动备份：false 禁用；间隔与保留期见 backupDb（默认每日 / 7 天）
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_MS=86400000
# 备份容量上限：最多几份（默认 14）与总共占多少 MB（0 = 不按容量删）。
# 每份备份都带 uploads + 模板快照，只按天数删的话份数由上面的间隔决定，磁盘放大没有上界。
# BACKUP_MAX_COUNT=14
# BACKUP_MAX_TOTAL_MB=0
# 审计日志保留天数（默认 180）
# AUDIT_RETENTION_DAYS=180
# 上传孤儿文件定时扫描（毫秒，>=60000 开启；UPLOADS_ORPHAN_AUTODELETE=1 才真正删除）
# UPLOADS_ORPHAN_SCAN_MS=0

# ---- AI 助手（OpenAI 兼容接口，可选；不配置即禁用，也可登录后在 AI 管理页配置并存 SQLite）----
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- 前端（Vite 注入）----
# 前端 axios baseURL 固定为相对路径 /api（单进程同源直连），此变量当前无代码引用，留空即可
VITE_API_BASE_URL=
